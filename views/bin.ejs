<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Recycle Hub - Go Green</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container" style="max-width: 800px; margin-top: 50px;">
        <header style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>♻️ Recycle Hub</h1>
                <p>Incoming Waste Batches from Collectors.</p>
            </div>
            <a href="/logout" class="btn btn-secondary">Logout</a>
        </header>

        <div class="houses-grid" style="grid-template-columns: 1fr 1fr; margin-top: 30px;">

            <% if (batches.length===0) { %>
                <p>No incoming batches at the moment.</p>
                <% } else { %>
                    <% batches.forEach(batch=> { %>
                        <div class="house">
                            <h3>Floor: <%= batch.floor %>
                            </h3>
                            <p style="font-size: 0.9rem; color: #666;">Batch ID: <%= batch.batchId %>
                            </p>
                            <hr style="margin: 10px 0; border: 0; border-top: 1px solid #ddd;">
                            <p>Tell this code to Collector:</p>

                            <h1 style="color: var(--primary); font-size: 2.5rem; letter-spacing: 5px; margin: 10px 0;">
                                <%= batch.handShakeCode %>
                            </h1>
                        </div>
                        <% }) %>
                            <% } %>
        </div>
    </div>
</body>

</html>