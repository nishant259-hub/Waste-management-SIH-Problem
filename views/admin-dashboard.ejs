<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Waste Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            background: var(--card-bg);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border-left: 5px solid var(--primary-color);
            text-align: center;
        }

        .kpi-title {
            color: #666;
            font-size: 0.9rem;
            text-transform: uppercase;
            font-weight: 600;
        }

        .kpi-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-top: 10px;
        }

        /* Floor Cards Grid */
        .floor-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 25px;
        }

        .floor-card {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: var(--shadow);
            border: 1px solid #e0e0e0;
        }

        .floor-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 2px solid var(--secondary-color);
            padding-bottom: 10px;
        }

        .floor-header h3 {
            color: var(--primary-color);
            margin: 0;
            text-transform: capitalize;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-item {
            background: var(--secondary-color);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-label {
            font-size: 0.8rem;
            color: #555;
            display: block;
            margin-bottom: 5px;
        }

        .stat-val {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--text-color);
        }

        /* Progress Bar */
        .progress-wrapper {
            margin-top: 15px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }

        .progress-bg {
            height: 10px;
            background: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background-color: var(--primary-color);
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <% let grandTotal=0, grandRecycled=0, grandPending=0, grandUnavailable=0; reports.forEach(r=> {
        grandTotal += r.total;
        grandRecycled += r.recycled;
        grandPending += r.pendingAtHub;
        grandUnavailable += r.unavailable;
        });
        %>

        <div class="admin-container">
            <header class="header-actions">
                <div>
                    <h1>Admin Control Panel</h1>
                    <p>Waste Collection Overview</p>
                </div>
                <a href="/logout" class="btn btn-secondary">Logout</a>
            </header>

            <div class="kpi-grid">
                <div class="kpi-card" style="border-color: #333;">
                    <div class="kpi-title">Total Houses</div>
                    <div class="kpi-value" style="color: #333;">
                        <%= grandTotal %>
                    </div>
                </div>
                <div class="kpi-card" style="border-color: #f57c00;">
                    <div class="kpi-title">In Transit (Hub)</div>
                    <div class="kpi-value" style="color: #f57c00;">
                        <%= grandPending %>
                    </div>
                </div>
                <div class="kpi-card" style="border-color: var(--primary-color);">
                    <div class="kpi-title">Successfully Recycled</div>
                    <div class="kpi-value">
                        <%= grandRecycled %>
                    </div>
                </div>
                <div class="kpi-card" style="border-color: #d32f2f;">
                    <div class="kpi-title">Unavailable / Locked</div>
                    <div class="kpi-value" style="color: #d32f2f;">
                        <%= grandUnavailable %>
                    </div>
                </div>
            </div>

            <div class="floor-grid">
                <% if (reports.length===0) { %>
                    <div class="empty-state">No data available yet.</div>
                    <% } else { %>
                        <% reports.forEach(report=> { %>
                            <div class="floor-card">
                                <div class="floor-header">
                                    <h3>
                                        <%= report.floorName.replace('_', ' ' ) %>
                                    </h3>
                                    <% if (report.needCleaning===0) { %>
                                        <span class="badge clean">Excellent</span>
                                        <% } else if (report.needCleaning> report.total / 2) { %>
                                            <span class="badge needs-cleaning">Slacking</span>
                                            <% } else { %>
                                                <span class="badge"
                                                    style="background:#fff3cd; color:#856404; border:1px solid #ffeeba;">In
                                                    Progress</span>
                                                <% } %>
                                </div>

                                <div class="stats-grid">
                                    <div class="stat-item">
                                        <span class="stat-label">Need Cleaning</span>
                                        <span class="stat-val" style="color: #d32f2f;">
                                            <%= report.needCleaning %>
                                        </span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-label">Collected</span>
                                        <span class="stat-val" style="color: var(--primary-color);">
                                            <%= report.collected %>
                                        </span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-label">Pending @ Hub</span>
                                        <span class="stat-val" style="color: #f57c00;">
                                            <%= report.pendingAtHub %>
                                        </span>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-label">Recycled</span>
                                        <span class="stat-val" style="color: var(--primary-color);">
                                            <%= report.recycled %>
                                        </span>
                                    </div>
                                </div>

                                <% let doneCount=report.total - report.needCleaning; let percent=report.total> 0 ?
                                    Math.round((doneCount / report.total) * 100) : 0;
                                    %>
                                    <div class="progress-wrapper">
                                        <div class="progress-info">
                                            <span>Completion</span>
                                            <span>
                                                <%= percent %>%
                                            </span>
                                        </div>
                                        <div class="progress-bg">
                                            <div class="progress-fill" style="width: <%= percent %>%"></div>
                                        </div>
                                    </div>
                            </div>
                            <% }) %>
                                <% } %>
            </div>
        </div>
</body>

</html>